PORT=10000
WHATSAPP_SERVER_API_KEY=replace_with_a_random_secret_at_least_32_characters
WHATSAPP_AUTH_PATH=/var/data/.wwebjs_auth
FRONTEND_ORIGINS=https://www.webglut.me,https://webglut.me
FIREBASE_PROJECT_ID=leadglut
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@leadglut.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Optional when the Render image uses a system-installed Chromium binary.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
